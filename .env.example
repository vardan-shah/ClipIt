# ---- ClipIt settings. Copy this file to .env and fill it in. Never commit .env. ----
#
# On your own computer you need nothing here: start ClipIt, open it, and add your AI key under Settings, AI.
# This file is for servers, and for anyone who prefers to keep settings in a file.

# ================================================================ AI: bring your own key
# The easy way is the dashboard: Settings, AI. Whatever is saved there is used instead of these lines.
# ClipIt uses an AI model to pick the moments worth clipping and to write hooks, titles and captions.
# You choose the service and pay that service directly; ClipIt adds nothing on top.
# Without a key ClipIt still works: clips are then picked by loudness only, with no titles.
#
#   provider     where to get a key                          example model ids (check the provider's current list)
#   gemini       https://aistudio.google.com/apikey           gemini-2.5-flash
#   openai       https://platform.openai.com/api-keys         gpt-4o-mini
#   xai          https://console.x.ai                         grok-4            (Grok)
#   groq         https://console.groq.com/keys                llama-3.3-70b-versatile
#   openrouter   https://openrouter.ai/keys                   any model id listed there
#   anthropic    https://console.anthropic.com                a current Claude model id
#   ollama       no key: a model running on this machine      llama3.1:8b       (ollama pull llama3.1:8b)
#   custom       any service that speaks the OpenAI chat format: also set CLIPIT_AI_BASE_URL
# To run without paying anything, copy .env.free.example instead and read FREE.md.
CLIPIT_AI_PROVIDER=gemini
CLIPIT_AI_MODELS=
CLIPIT_AI_KEY=
# CLIPIT_AI_KEY_FILE=/secrets/ai.txt        # instead of CLIPIT_AI_KEY: a file that holds the key
# CLIPIT_AI_BASE_URL=                       # only for "custom", e.g. http://127.0.0.1:1234/v1
# CLIPIT_AI_MODELS takes several ids separated by commas. They are tried in order, so the second is a fallback.

# Other services to ask, in order, when the main one is busy or out of free requests. Each is service:model, and
# only the first colon splits them (ollama:llama3.1:8b is the service ollama and the model llama3.1:8b).
# Each needs its own key: CLIPIT_AI_KEY_<SERVICE> (or CLIPIT_AI_KEY_<SERVICE>_FILE), and it may have its own
# address: CLIPIT_AI_BASE_URL_<SERVICE>. A local Ollama needs no key.
# CLIPIT_AI_FALLBACKS=groq:some-model-id,ollama:llama3.1:8b
# CLIPIT_AI_KEY_GROQ=
# Minutes of transcript read per request (default: 15). Smaller means more, smaller requests, which suits free
# plans that allow few tokens a minute and small local models.
# CLIPIT_AI_WINDOW_MIN=6
# Ollama only: tokens it reads per request, and the most ClipIt will raise that to for a long request.
# CLIPIT_OLLAMA_NUM_CTX=16384
# CLIPIT_OLLAMA_MAX_CTX=32768
# Check the whole setup from a terminal:   python -m studio.ai_check

# ================================================================ on a server (Docker): see DEPLOY.md
# Your domain (DNS must already point at this server) and a database password you make up.
# CLIPIT_DOMAIN=clipit.example.com
# POSTGRES_PASSWORD=change-me-to-a-long-random-string

# A server ClipIt has to itself: keep this line, and ClipIt fetches its own HTTPS certificate.
# A server that already runs a web server for other sites: leave it out and see deploy/nginx-clipit.conf.
# COMPOSE_PROFILES=own-https
# Behind Cloudflare's CDN: put the Cloudflare origin certificate in ./secrets as cloudflare-origin.crt and
# cloudflare-origin.key, and use the Caddyfile that serves it.
# CLIPIT_CADDYFILE=Caddyfile.origin
# CLIPIT_BIND_PORT=8765           # the port ClipIt listens on inside the server, if 8765 is taken
# Behind a Traefik that is already on the server, use this instead of the own-https line:
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.traefik.yml
# If the domain goes through Cloudflare's CDN (orange cloud), the visitor's real address comes in this header.
# It is only believed for connections that really come from Cloudflare.
# CLIPIT_CLIENT_IP_HEADER=CF-Connecting-IP

# On a server shared with other apps: keep ClipIt inside its own share.
# CLIPIT_MEM_LIMIT=2g             # most memory it may use (it is stopped, not the other apps, if it goes over)
# CLIPIT_CPUS=1.5                 # most processor cores it may use
# CLIPIT_CPU_SHARES=256           # its turn at the processor when the server is busy (1024 is normal)
# CLIPIT_OOM_SCORE_ADJ=900        # if the whole server runs out of memory, ClipIt is stopped first
# CLIPIT_DB_MEM_LIMIT=256m

# ================================================================ where things are kept (own computer)
# CLIPIT_DATA=./data              # videos, clips, the database file and the speech model
# CLIPIT_PORT=8765
# CLIPIT_PUBLIC_URL=http://127.0.0.1:8765     # the address people open; set it to https://your-domain on a server
# DATABASE_URL=                    # empty: a SQLite file in the data folder. Or postgresql+psycopg://user:pass@host/db

# ================================================================ sign-in
# Off by default: ClipIt opens straight into the dashboard, which is right for your own computer.
# On a server other people can reach, turn accounts on, or anyone who finds the address can use it and your AI key.
# (docker-compose.yml turns them on by itself.)
# CLIPIT_ACCOUNTS=1

# ================================================================ admins (only with accounts on)
# Admins are not set here. Every new account is a normal user. After you sign up, make yourself an admin:
#   python -m studio.admin grant you@example.com                 (also: revoke, list)
#   docker compose exec app python -m studio.admin grant you@example.com      (with Docker)
# The admin dashboard is then at /admin, and does not exist for anyone else.

# ================================================================ Google (optional)
# One "Web application" OAuth client, used for Sign in with Google and for connecting YouTube to post Shorts.
# Authorised redirect URIs:  https://YOUR-DOMAIN/auth/google/callback  and  https://YOUR-DOMAIN/oauth/youtube/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_FILE=/secrets/google_client.json

# Instagram: the app people's accounts connect through (Connect button in Settings, Connected apps).
# It can also be pasted in the dashboard by an admin: Settings, Connected apps, Set up. Redirect address to
# register:  https://YOUR-DOMAIN/oauth/instagram/callback
# CLIPIT_IG_APP_ID=
# CLIPIT_IG_APP_SECRET=

# ================================================================ email (optional)
# Any SMTP service. Without it, password-reset and confirmation links are printed in the server's output instead,
# which is enough on your own computer.
# CLIPIT_SMTP_HOST=
# CLIPIT_SMTP_PORT=587
# CLIPIT_SMTP_USER=
# CLIPIT_SMTP_PASSWORD=
# CLIPIT_SMTP_PASSWORD_FILE=/secrets/smtp.txt
# CLIPIT_MAIL_FROM=ClipIt <hello@your-domain.com>
# CLIPIT_VERIFY_EMAIL=1           # on a public site: people must confirm their email before clipping

# Shown on the privacy, terms and acceptable-use pages of a public site.
# CLIPIT_CONTACT_EMAIL=
# CLIPIT_LEGAL_NAME=
# CLIPIT_LEGAL_COUNTRY=

# ================================================================ limits (all optional)
# How many videos run at once is decided by how busy the machine really is, every second. These only set the edges:
# CLIPIT_JOB_WORKERS=8            # the most videos that may ever run at once (default: one per CPU core)
# CLIPIT_BUSY_CPU=82              # no extra video or recording starts while the processor is above this percent
# CLIPIT_MIN_FREE_RAM_GB=1.5      # ...or while less memory than this is free
# There are no limits unless you set one here: 0 (the default) means none. A server other people use may want some.
# CLIPIT_MAX_LIVE=8               # live recordings at once, whole server (default: twice the CPU cores; load decides below it)
# CLIPIT_MAX_LIVE_PER_USER=0      # streams one person records at once
# CLIPIT_MAX_JOBS_PER_USER=5      # videos one person sends and has worked on at once
# CLIPIT_MAX_UPLOAD_MB=0          # the largest video file someone may upload
# CLIPIT_UPLOAD_PART_MB=40        # big files are sent in pieces of this size (Cloudflare refuses requests over 100 MB)
# CLIPIT_MAX_VIDEO_HOURS=0        # longest video, or chosen part of one, that is processed
# CLIPIT_MAX_LIVE_HOURS=0         # a live recording stops by itself after this long
# CLIPIT_MAX_USER_GB=0            # disk space one account may use
# CLIPIT_MAX_CREATORS=0           # creators one account may add
# CLIPIT_FFMPEG_DIR=              # the folder that holds ffmpeg, if ClipIt cannot find it by itself
# CLIPIT_CLIP_MINUTES=15          # a clip that takes longer than this to make is stopped, so it cannot hold the video up
# CLIPIT_ALLOWED_SITES=youtube.com,youtu.be,twitch.tv,kick.com
# CLIPIT_YT_TRANSCRIPT=1          # use YouTube's own transcript to find clips faster (0: always transcribe here)
# CLIPIT_UPDATE_CHECK=1          # look on GitHub once a minute for a newer ClipIt (0: never)

# ================================================================ speech to text on a graphics card (optional)
# Speech is transcribed on this machine's processor by default. A second machine with an NVIDIA card can take
# over most of it: see deploy/gpu/docker-compose.yml, then set these on the main server.
# CLIPIT_ASR_URL=http://10.0.0.2:9000
# CLIPIT_ASR_TOKEN=a-long-random-string-shared-by-both-machines
